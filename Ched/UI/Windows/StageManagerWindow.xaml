<Window x:Class="Ched.UI.Windows.StageManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:b="clr-namespace:Ched.UI.Windows.Behaviors"
        xmlns:conv="clr-namespace:Ched.UI.Windows.Converters"
        xmlns:local="clr-namespace:Ched.UI.Windows"
        xmlns:localization="clr-namespace:Ched.Localization"
        Title="{x:Static localization:MainFormStrings.Stage}" Height="335" Width="400"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:StageManagerWindowViewModel}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="ContentRendered">
            <i:CallMethodAction TargetObject="{Binding}" MethodName="BeginEdit" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="42.4"/>
            <RowDefinition/>
            <RowDefinition Height="Auto" MinHeight="233.96"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Grid.Column="0" Content="{x:Static localization:MainFormStrings.Number}" />
            <local:BindableNumericUpDown x:Name="InputNumberBox" Width="70" Margin="0,0,10,0" Padding="2" DecimalPlaces="0" Increment="1" Maximum="10000000000" Minimum="0"/>
            <Label Grid.Column="0" Content="{x:Static localization:MainFormStrings.Name}" />
            <TextBox x:Name="InputTextBox" Width="100" Margin="0,0,10,0" Padding="2"/>
            <Button Content="追加" Width="50" Click="AddButton_Click"  />
            <Button Content="変更" Width="50" Click="ChangeButton_Click" Margin="15,0,0,0"/>
        </StackPanel>
        <ListBox x:Name="ItemListBox" Margin="0,42,0,44" Grid.RowSpan="3" ItemsSource="{Binding Items}" MouseDoubleClick="ItemListBox_MouseDoubleClick" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Width="100" />
                        <TextBlock Text= "{x:Static localization:MainFormStrings.Number}" Foreground="Gray"/>
                        <TextBlock Text="{Binding Number}" Foreground="Blue" FontWeight="Bold" />
                        <TextBlock Text=" ID: " Foreground="Gray" />
                        <TextBlock Text="{Binding ID}" Foreground="Blue" FontWeight="Bold" />
                        <TextBlock Text=" FromStart: " Foreground="Gray" />
                        <TextBlock Text="{Binding FromStart}" Foreground="Blue" FontWeight="Bold" />
                        <TextBlock Text=" ToEnd: " Foreground="Gray" />
                        <TextBlock Text="{Binding UntilEnd}" Foreground="Blue" FontWeight="Bold" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,-10" >
            <Button Content="選択した項目を削除" Click="DeleteButton_Click" Padding="5" Margin="0,195,148,10"/>
            <Button Content="OK" IsDefault="True" Margin="-30,200,0,14"  Width="67" HorizontalAlignment="Left">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:CallMethodAction TargetObject="{Binding}" MethodName="CommitEdit" />
                        <i:ChangePropertyAction TargetObject="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" PropertyName="DialogResult" Value="True" />
                        <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" MethodName="Close" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
            <Button Content="{x:Static localization:MainFormStrings.Cancel}" IsCancel="True" Margin="10,200,0,14">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:ChangePropertyAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}" PropertyName="DialogResult" Value="False" />
                        <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}" MethodName="Close" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
        </StackPanel>

    </Grid>

</Window>