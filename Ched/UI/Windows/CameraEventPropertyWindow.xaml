<Window x:Class="Ched.UI.Windows.CameraEventPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:b="clr-namespace:Ched.UI.Windows.Behaviors"
        xmlns:conv="clr-namespace:Ched.UI.Windows.Converters"
        xmlns:local="clr-namespace:Ched.UI.Windows"
        xmlns:localization="clr-namespace:Ched.Localization"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="600"
        Title="{x:Static localization:MainFormStrings.Property}"
        Style="{DynamicResource DialogWindowStyle}"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:CameraEventPropertiesWindowViewModel}">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="ContentRendered">
            <i:CallMethodAction TargetObject="{Binding}" MethodName="BeginEdit" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="GroupBox">
                <Setter Property="Padding" Value="6px" />
            </Style>

            <Style x:Key="InputFieldRow" TargetType="Grid">
                <Setter Property="Margin" Value="{StaticResource RowMargin}" />
                <Style.Resources>
                    <Style TargetType="Label">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="Margin" Value="0,0,8px,0" />
                    </Style>
                </Style.Resources>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource WindowContainerMargin}">
        <StackPanel Orientation="Vertical">
            <GroupBox Header="{x:Static localization:MainFormStrings.BasicInformation}" Margin="{StaticResource ContainerMargin}">
                <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True">
                    <Grid Style="{StaticResource ResourceKey=InputFieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="{x:Static localization:MainFormStrings.Tick}" />
                        <local:BindableNumericUpDown Grid.Column="1" Value="{Binding EventTick}" DecimalPlaces="0" Increment="1" Maximum="1000000000000000" Minimum="-3686400" />
                    </Grid>
                    <Grid Style="{StaticResource ResourceKey=InputFieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="{x:Static localization:MainFormStrings.LaneIndex}" />
                        <local:BindableNumericUpDown Grid.Column="1" Value="{Binding LaneIndex}" DecimalPlaces="4" Increment="1" Minimum="-10000000000"  Maximum="10000000000" Margin="0,0,250,0" />
                        <Label Grid.Column="1" Content="{x:Static localization:MainFormStrings.Width}" RenderTransformOrigin="1.839,0.469" HorizontalAlignment="Center" />
                        <local:BindableNumericUpDown Grid.Column="1" Value="{Binding Width}" DecimalPlaces="4" Increment="1" Minimum="-10000000000"  Maximum="10000000000" Margin="250,0,0,0" />
                    </Grid>
                    <Grid Style="{StaticResource ResourceKey=InputFieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="{x:Static localization:MainFormStrings.Zoom}" />
                        <local:BindableNumericUpDown Grid.Column="1" Value="{Binding Zoom}" DecimalPlaces="1" Increment="1" Minimum="-1"  Maximum="10000000000" />
                    </Grid>
                    <Grid Style="{StaticResource ResourceKey=InputFieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="{x:Static localization:MainFormStrings.ZoomLane}" />
                        <local:BindableNumericUpDown Grid.Column="1" Value="{Binding ZoomLane}" DecimalPlaces="2" Increment="1" Minimum="-10000000000"  Maximum="10000000000" Margin="0,0,299,0" />
                        <Label Grid.Column="1" Content="{x:Static localization:MainFormStrings.ZoomY}" RenderTransformOrigin="1.839,0.469" HorizontalAlignment="Center" />
                        <local:BindableNumericUpDown Grid.Column="1" Value="{Binding ZoomY}" DecimalPlaces="2" Increment="1" Minimum="-10000000000"  Maximum="10000000000" Margin="300,0,0,0" />
                    </Grid>
                    <Grid Style="{StaticResource ResourceKey=InputFieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Content="{x:Static localization:MainFormStrings.ZoomAlignCenter}" IsChecked="{Binding ZoomAlign}" Margin="0,-4,426,4" Grid.ColumnSpan="2" />
                    </Grid>
                    
                    <Grid Style="{StaticResource ResourceKey=InputFieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="{x:Static localization:MainFormStrings.Rotation}" />
                        <local:BindableNumericUpDown Grid.Column="1" Value="{Binding Rotation}" DecimalPlaces="1" Increment="1" Minimum="-10000000000"  Maximum="10000000000" Margin="0,0,299,0" />
                        <Label Grid.Column="1" Content="{x:Static localization:MainFormStrings.Tilt}" RenderTransformOrigin="1.839,0.469" HorizontalAlignment="Center" />
                        <local:BindableNumericUpDown Grid.Column="1" Value="{Binding Tilt}" DecimalPlaces="1" Increment="0.1" Minimum="-1"  Maximum="2" Margin="300,0,0,0" />
                    </Grid>
                    
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static localization:MainFormStrings.Other}" Margin="{StaticResource ContainerMargin}">

                <Grid Style="{StaticResource ResourceKey=InputFieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Content="{x:Static localization:MainFormStrings.Ease}" />
                    <local:BindableNumericUpDown Grid.Column="1" Value="{Binding Ease}" DecimalPlaces="0" Increment="1" Minimum="0"  Maximum="5" />
                </Grid>


            </GroupBox>

            <StackPanel Orientation="Horizontal" Margin="{StaticResource ContainerMargin}" HorizontalAlignment="Right">
                <Button Content="OK" IsDefault="True">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <i:CallMethodAction TargetObject="{Binding}" MethodName="CommitEdit" />
                            <i:ChangePropertyAction TargetObject="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" PropertyName="DialogResult" Value="True" />
                            <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" MethodName="Close" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
                <Button Content="{x:Static localization:MainFormStrings.Cancel}" IsCancel="True">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <i:ChangePropertyAction TargetObject="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" PropertyName="DialogResult" Value="False" />
                            <i:CallMethodAction TargetObject="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" MethodName="Close" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
            </StackPanel>
        </StackPanel>
        
    </Grid>
</Window>
